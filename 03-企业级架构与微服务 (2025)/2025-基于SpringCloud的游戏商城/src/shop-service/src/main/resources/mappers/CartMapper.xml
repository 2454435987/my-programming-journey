    <!--根据用户主键和商品名称进行模糊分页查询和普通分页查询-->
    <select id="getCartPageByUidAndPname" resultMap="cartMap">
        SELECT
        c.cid,c.pquantity,p.pid,p.pname,p.price,u.uid,u.name,u.telephone
        FROM cart c,t_product p,USER u
        WHERE c.uid=u.uid AND c.pid=p.pid
        <if test="uid!=null">
            AND u.uid=#{uid}
        </if>
        <if test="pname!=null">
            AND p.pname LIKE CONCAT("%",#{pname},"%")
        </if>
        LIMIT #{start},#{pageSize}
    </select>

    <!--计算普通分页与模糊分页的总记录数-->
    <select id="myCount" resultType="int">
        SELECT COUNT(*)
        FROM cart c,t_product p,USER u
        WHERE c.uid=u.uid AND c.pid=p.pid
        <if test="uid!=null">
          AND u.uid=#{uid}
        </if>
        <if test="pname!=null">
            AND p.pname LIKE CONCAT("%",#{pname},"%")
        </if>
    </select>
</mapper>
