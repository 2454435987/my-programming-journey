<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.baidu.dao.CommentMapper">

    <!-- 联表查询评论和用户名 -->
    <select id="selectCommentsWithUserName" resultType="com.baidu.pojo.Comment">
        SELECT c.*, u.name as userName 
        FROM t_comment c 
        LEFT JOIN user u ON c.uid = u.uid 
        WHERE c.pid = #{pid} 
        ORDER BY c.create_time DESC
    </select>

    <!-- 检查用户是否有支付过的订单（直接去 t_order 找一条已支付的记录提取 oid） -->
    <select id="checkUserPurchased" resultType="java.lang.Integer">
        SELECT oid 
        FROM t_order 
        WHERE uid = #{uid} AND status = '已支付' 
        LIMIT 1
    </select>

</mapper>
