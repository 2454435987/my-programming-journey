<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.baidu.dao.LocationMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.baidu.pojo.Location">
        <id column="aid" property="aid" />
        <result column="realName" property="realName" />
        <result column="phone" property="phone" />
        <result column="identity" property="identity" />
        <result column="address" property="address" />
        <result column="oid" property="oid" />
        <result column="uid" property="uid" />

        <association property="order" javaType="com.baidu.pojo.Order">
            <id property="oid" column="oid"/>
        </association>
    </resultMap>
    <!--        根据用户电话号进行分页查询-->
    <select id="getLocationByPage" resultMap="BaseResultMap">
        SELECT l.* FROM location l
        left JOIN t_order o
        on l.oid=o.oid
        <where>
            <if test="phone!=null and phone!=''">
                and l.phone like CONCAT(#{phone},'%')
            </if>
            <if test="uid != null and uid != ''">
                and l.uid = #{uid}
            </if>
        </where>
        order by l.aid desc
        limit #{start},#{pageSize}
    </select>

<!--    计算分页总记录数-->
    <select id="myCount" resultType="int">
        select count(*) from location l
        <where>
            <if test="phone!=null and phone!=''">
                and l.phone like CONCAT(#{phone},'%')
            </if>
            <if test="uid != null and uid != ''">
                and l.uid = #{uid}
            </if>
        </where>
    </select>
</mapper>
